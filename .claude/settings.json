{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"F:/something_simple/intervention-zero/.venv/Scripts/python.exe\" \"F:/something_simple/intervention-zero/.claude/hooks/guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"F:/something_simple/intervention-zero/.venv/Scripts/python.exe\" \"F:/something_simple/intervention-zero/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
