# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas (Sandbox project, Cluster0) — Connect > Drivers > Python
MONGODB_URI=
MONGODB_DB=intervention_zero

# Voyage via Atlas AI Model APIs (Atlas UI > AI Model APIs > create key)
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-4-large
VOYAGE_RERANK_MODEL=rerank-2.5

# Raindrop (raindrop.ai) — write key for events/signals, query key for read-back
RAINDROP_WRITE_KEY=
RAINDROP_QUERY_API_KEY=
RAINDROP_ENABLED=0

# LLM provider: anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ROBOT_MODEL=
FIXER_MODEL=
MAX_LLM_USD=15

# Atlas Agent Engine memory side-quest (optional)
AGENT_ENGINE_ENABLED=0
AGENT_ENGINE_TOKEN=

# Runtime
DEMO_MODE=1
